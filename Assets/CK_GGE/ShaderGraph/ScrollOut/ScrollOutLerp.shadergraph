{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "a361baf4e76f496faee4460e49733699",
    "m_Title": "Lerp의 다른 관점",
    "m_Content": "Lerp는 Alpha 값에 0~1 범위의 텍스처나 UV 등 다양한 값이 입력될 때 A와 B의 min, max 범위로 Remap해서 내보내는 특성이 있다.\r\n이 특성을 이용해 A와 B를 0~1이 아닌, Scroll 값에 연동되어 애니메이션 되는 가로 UV 입력값으로 사용한다.\r\n\r\n원리를 이해할 때 Stretch 값이 0.3이라는 가정을 하고,\r\nScroll이 0 ~ 1로 변할 때 A와 B가 어떤 값이 되어야하는지 생각하면 쉽다.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1555.0,
        "y": -468.0,
        "width": 302.0,
        "height": 181.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

